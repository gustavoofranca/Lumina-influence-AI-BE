# =========================================================
# Lumina Influence AI - Back-End
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env real.
# =========================================================

# Ambiente: dev | test | staging | prod
FLASK_ENV=dev
FLASK_APP=wsgi.py

# ---------- Banco de dados ----------
# Formato: postgresql://user:senha@host:porta/banco
# `db` é o nome do serviço Postgres no compose. De dentro do container o
# Postgres NÃO atende em localhost — use `db`.
DATABASE_URL=postgresql://lumina:lumina@db:5432/lumina_dev
#
# Instância gerenciada (Supabase): use a string do Session pooler, não a
# conexão direta. `db.<ref>.supabase.co` resolve apenas em IPv6 e a rede do
# container é IPv4 — a conexão falha com "Network is unreachable".
# Se a senha tiver [ ] @ / # ? : %, faça percent-encoding antes de colar.

# Banco usado pelos testes (opcional — default é sqlite:///:memory:)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina_test

# ---------- Segurança ----------
# Secret para assinar JWTs. Em produção, gere algo forte: `python -c "import secrets;print(secrets.token_urlsafe(64))"`
JWT_SECRET=change-me-in-production

# Chave Fernet para criptografar tokens das APIs sociais em repouso.
# Gere com: `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
FERNET_KEY=

# ---------- APIs sociais (B8) ----------
# Meta (Instagram) — https://developers.facebook.com/apps (exige App Review p/ prod)
META_CLIENT_ID=
META_CLIENT_SECRET=
# TikTok — https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# YouTube — habilite a YouTube Data API v3 no projeto Google Cloud.
# Se vazio, usa GOOGLE_CLIENT_ID/SECRET (mesmo projeto do login).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ---------- OAuth de login do app ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------- IA ----------
# Google AI Studio (https://aistudio.google.com/apikey) -> Create API key
GEMINI_API_KEY=
# Modelo das análises. gemini-2.0-flash e gemini-2.5-flash foram retirados e
# respondem 404 — a própria API indica gemini-3.6-flash como substituto.
GEMINI_MODEL=gemini-3.6-flash
# Timeout das chamadas ao Gemini (segundos)
# Medido: a análise completa levou 59s. 30s abortava antes da resposta.
GEMINI_TIMEOUT_SECONDS=90
# Máximo de comentários enviados no prompt (controle de custo/contexto)
GEMINI_MAX_COMMENTS=30

# ---------- Jobs ----------
# O free tier do Gemini permite 20 requisições por dia e por modelo. Com o
# scheduler ligado, run_pending_analyses (a cada 30 min, 5 análises por vez)
# consome a cota inteira sozinho nas primeiras horas do dia — e uma análise
# feita à mão depois disso falha com 429. Deixe 1 e rode sob demanda:
#   flask jobs run run_pending_analyses
LUMINA_DISABLE_SCHEDULER=1

# ---------- CORS ----------
# Origem do front-end autorizada a chamar a API.
FRONTEND_ORIGIN=http://localhost:5173
