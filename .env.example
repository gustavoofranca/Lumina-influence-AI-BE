# =========================================================
# Lumina Influence AI - Back-End
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env real.
# =========================================================

# Ambiente: dev | test | staging | prod
FLASK_ENV=dev
FLASK_APP=wsgi.py

# ---------- Banco de dados ----------
# PostgreSQL local (formato: postgresql://user:senha@host:porta/banco)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina_dev

# Banco usado pelos testes (opcional — default é sqlite:///:memory:)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina_test

# ---------- Segurança ----------
# Secret para assinar JWTs. Em produção, gere algo forte: `python -c "import secrets;print(secrets.token_urlsafe(64))"`
JWT_SECRET=change-me-in-production

# Chave Fernet para criptografar tokens das APIs sociais em repouso.
# Gere com: `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
FERNET_KEY=

# ---------- OAuth de login do app ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------- IA ----------
# Google AI Studio -> Get API key
GEMINI_API_KEY=

# ---------- CORS ----------
# Origem do front-end autorizada a chamar a API.
FRONTEND_ORIGIN=http://localhost:5173
