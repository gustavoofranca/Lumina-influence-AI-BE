# Variáveis que MUDAM em produção. O .env do VPS (Lumina-Influence-AI-BE/.env)
# é o .env de desenvolvimento com estas linhas trocadas ou acrescentadas.
# Nunca versione o .env real.

# Domínio e certificado
DOMINIO=seudominio.com.br
# E-mail para avisos do Let's Encrypt (expiração de certificado).
ACME_EMAIL=voce@gmail.com
# Branch que o deploy.sh baixa nos dois repositórios.
DEPLOY_BRANCH=main

# Ambiente: prod desliga o login de demonstração e o provedor social de
# demonstração, e exige as variáveis abaixo no boot.
FLASK_ENV=prod
FRONTEND_ORIGIN=https://seudominio.com.br
OAUTH_REDIRECT_BASE=https://api.seudominio.com.br
AUTH_SUCCESS_REDIRECT=https://seudominio.com.br/auth/callback
# E-mail publicado nas páginas legais do front (entra no build).
VITE_CONTACT_EMAIL=voce@gmail.com

# SMTP é obrigatório em produção (verificação de e-mail, redefinição de senha).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=voce@gmail.com
SMTP_PASSWORD=senha-de-app-sem-espacos
SMTP_FROM=Lumina <voce@gmail.com>

# Iguais ao desenvolvimento (o banco é o mesmo Supabase):
# DATABASE_URL, FERNET_KEY (precisa ser a MESMA: descriptografa os tokens das
# redes sociais gravados no banco), GEMINI_*, credenciais OAuth.
# JWT_SECRET pode ser novo: só derruba as sessões abertas.
